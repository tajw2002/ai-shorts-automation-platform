# =============================================================================
# AI Shorts Automation Platform — environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
# In production, load these from Google Secret Manager rather than a file.
#
# The API validates this file at boot (zod). A missing or malformed required
# value fails startup loudly instead of misbehaving later.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
# api | worker | all   (Cloud Run runs the same image in different roles)
APP_ROLE=all
PORT=3001
LOG_LEVEL=debug
# Base URL the API is reachable at (used for OAuth redirects and task callbacks)
API_BASE_URL=http://localhost:3001
# Base URL of the dashboard (used for CORS and post-OAuth redirects)
WEB_BASE_URL=http://localhost:3000
TIMEZONE=Europe/Berlin

# -----------------------------------------------------------------------------
# SAFETY SWITCHES — these defaults are deliberately conservative.
# Do not relax them until the pipeline has run reliably end to end.
# -----------------------------------------------------------------------------
# true  => no paid API calls, no real uploads; mock providers are forced.
DRY_RUN=true
# true  => a human must approve every video before it can be uploaded.
REQUIRE_APPROVAL=true
# true  => approved videos may be published automatically by the scheduler.
AUTO_PUBLISH=false
# true  => global kill switch. Blocks all generation and all uploads.
EMERGENCY_STOP=false
# Privacy status applied to every upload unless explicitly overridden.
DEFAULT_PRIVACY_STATUS=private

# -----------------------------------------------------------------------------
# Quotas
# -----------------------------------------------------------------------------
MAX_DAILY_UPLOADS=3
MAX_MONTHLY_UPLOADS=60
MAX_CONCURRENT_GENERATIONS=2
MAX_JOB_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Cost control (US dollars)
# -----------------------------------------------------------------------------
MAX_DAILY_COST=10
MAX_MONTHLY_COST=200
# Fraction of a limit at which an admin warning is raised (0.0 - 1.0)
COST_WARN_THRESHOLD=0.8

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://shorts:shorts@localhost:5432/shorts?schema=public

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=
# 32 random bytes, base64. Encrypts OAuth refresh tokens at rest. NEVER rotate
# without re-encrypting existing rows (see docs/security.md).
ENCRYPTION_KEY=
# Shared secret protecting /internal/* endpoints in local development.
# In production these endpoints are protected by Cloud Tasks OIDC instead.
INTERNAL_API_KEY=
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Bootstrap admin, created by `npm run db:seed` if no user exists.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Provider selection
#   llm     : mock | anthropic | openai
#   video   : mock | replicate | fal
#   voice   : mock | elevenlabs | openai
#   storage : local | gcs
#   youtube : mock | google
#   queue   : inmemory | cloudtasks
# -----------------------------------------------------------------------------
LLM_PROVIDER=mock
VIDEO_PROVIDER=mock
VOICE_PROVIDER=mock
STORAGE_PROVIDER=local
YOUTUBE_PROVIDER=mock
QUEUE_PROVIDER=inmemory

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=120000
# Optional price overrides in USD per 1M tokens; used for cost estimation.
LLM_INPUT_COST_PER_MTOK=3
LLM_OUTPUT_COST_PER_MTOK=15

# -----------------------------------------------------------------------------
# Video provider
# -----------------------------------------------------------------------------
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_BASE_URL=
VIDEO_MODEL=
VIDEO_TIMEOUT_MS=600000
VIDEO_POLL_INTERVAL_MS=5000
VIDEO_COST_PER_SECOND=0.05
# Model-specific inputs, merged over the adapter's defaults (JSON object; a null
# value removes a key). Read the model's input schema first: Replicate rejects
# values outside it *before* running, e.g. {"fps":24,"resolution":"480p"}
VIDEO_INPUT_OVERRIDES=
# Clip length the model accepts, in seconds (0 = unbounded). Scene lengths are
# clamped to this range, and the clamped value is what the budget check uses.
VIDEO_CLIP_MIN_SECONDS=0
VIDEO_CLIP_MAX_SECONDS=0

# -----------------------------------------------------------------------------
# Voice provider
# -----------------------------------------------------------------------------
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_BASE_URL=
VOICE_MODEL=
VOICE_DEFAULT_VOICE_ID=
VOICE_TIMEOUT_MS=120000
VOICE_COST_PER_1K_CHARS=0.3

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# local provider
LOCAL_STORAGE_ROOT=./storage
# gcs provider
GCS_BUCKET=
GCS_PROJECT_ID=
# Leave empty on Cloud Run to use the attached service account (recommended).
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# YouTube / Google OAuth
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/v1/youtube/oauth/callback
# Numeric YouTube category id. 24 = Entertainment, 27 = Education, 1 = Film & Animation.
YOUTUBE_DEFAULT_CATEGORY_ID=24
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_UPLOAD_TIMEOUT_MS=900000

# -----------------------------------------------------------------------------
# Google Cloud (production)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=europe-west1
CLOUD_TASKS_QUEUE=shorts-jobs
CLOUD_TASKS_LOCATION=europe-west1
# Service account whose OIDC token Cloud Tasks presents to /internal/*
CLOUD_TASKS_INVOKER_SA=
# Audience the API expects in that OIDC token (usually the Cloud Run URL).
CLOUD_TASKS_OIDC_AUDIENCE=

# -----------------------------------------------------------------------------
# Media / FFmpeg
# -----------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_MS=900000
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_MIN_DURATION_SECONDS=15
VIDEO_MAX_DURATION_SECONDS=60
AUDIO_LOUDNESS_TARGET_LUFS=-14
SUBTITLES_ENABLED=true
SUBTITLE_STYLE=default
# Keep captions clear of the YouTube Shorts UI (percentage of frame height).
SUBTITLE_BOTTOM_MARGIN_PERCENT=22

# -----------------------------------------------------------------------------
# Content engine
# -----------------------------------------------------------------------------
CONTENT_NICHE=cute-ai-baby-and-animal-stories
CONTENT_LANGUAGE=en
IDEA_CANDIDATES_PER_REQUEST=5
IDEA_MAX_ATTEMPTS=3
# Similarity thresholds: a candidate is rejected at or above these values.
SIMILARITY_TITLE_THRESHOLD=0.75
SIMILARITY_SCRIPT_THRESHOLD=0.6
SIMILARITY_PROMPT_THRESHOLD=0.7
SIMILARITY_LOOKBACK=300

# -----------------------------------------------------------------------------
# Safety
# -----------------------------------------------------------------------------
# block | review  — what to do when the safety layer is uncertain.
SAFETY_UNCERTAIN_ACTION=review
SAFETY_LLM_REVIEW_ENABLED=false

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
ANALYTICS_SYNC_ENABLED=true
ANALYTICS_SYNC_INTERVAL_MINUTES=180
ANALYTICS_RETENTION_DAYS=400
