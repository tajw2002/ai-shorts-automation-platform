{
  "name": "ai-shorts-automation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade platform for generating and publishing original AI YouTube Shorts.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @shorts/contracts && npm run build --workspace @shorts/api && npm run build --workspace @shorts/web",
    "build:api": "npm run build --workspace @shorts/contracts && npm run build --workspace @shorts/api",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @shorts/api",
    "dev:web": "npm run dev --workspace @shorts/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "test": "npm run test --workspace @shorts/api",
    "test:watch": "npm run test:watch --workspace @shorts/api",
    "test:cov": "npm run test:cov --workspace @shorts/api",
    "db:generate": "npm run db:generate --workspace @shorts/api",
    "db:migrate": "npm run db:migrate --workspace @shorts/api",
    "db:deploy": "npm run db:deploy --workspace @shorts/api",
    "db:seed": "npm run db:seed --workspace @shorts/api",
    "db:reset": "npm run db:reset --workspace @shorts/api",
    "db:studio": "npm run db:studio --workspace @shorts/api",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
